# Copy this file to .env and fill in values locally.
# Never commit or share the real token.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_32_character_account_id
CLOUDFLARE_API_TOKEN=your_new_workers_ai_token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_AGENT_MODEL=@cf/meta/llama-3.1-8b-instruct

